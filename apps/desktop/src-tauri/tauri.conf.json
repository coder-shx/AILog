{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AILog",
  "version": "0.1.0",
  "identifier": "dev.ailog.app",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @ailog/server dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AILog",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
